{
  "name": "@grapesjs/webmcp",
  "version": "0.1.0",
  "description": "Expose the GrapesJS editor API as WebMCP tools for browser AI agents",
  "author": "Artur Arseniev",
  "license": "BSD-3-Clause",
  "homepage": "https://grapesjs.com",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/GrapesJS/grapesjs.git",
    "directory": "packages/webmcp"
  },
  "keywords": [
    "grapesjs",
    "plugin",
    "webmcp",
    "mcp",
    "ai",
    "agent"
  ],
  "scripts": {
    "start": "node node_modules/grapesjs-cli/dist/cli.js serve",
    "build": "run-s build:js build:mjs build:dts",
    "build:js": "node node_modules/grapesjs-cli/dist/cli.js build --dts=skip --patch=false",
    "build:mjs": "cross-env BUILD_MODULE=true node node_modules/grapesjs-cli/dist/cli.js build --dts=skip --patch=false",
    "ts:check": "tsc --noEmit",
    "test": "jest",
    "build:dts": "dts-bundle-generator -o dist/index.d.ts src/index.ts --project tsconfig.build.json --no-banner --no-check"
  },
  "peerDependencies": {
    "grapesjs": "^0.23.1"
  },
  "devDependencies": {
    "dts-bundle-generator": "^8.0.1",
    "grapesjs": "workspace:^",
    "grapesjs-cli": "workspace:^",
    "jest-environment-jsdom": "30.4.1",
    "npm-run-all": "4.1.5"
  }
}
