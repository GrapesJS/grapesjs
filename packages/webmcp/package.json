{
  "name": "@grapesjs/webmcp",
  "version": "0.1.1",
  "description": "Expose the GrapesJS editor API as WebMCP tools for browser AI agents",
  "author": "Artur Arseniev",
  "license": "BSD-3-Clause",
  "homepage": "https://grapesjs.com",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.mjs",
      "require": "./dist/index.cjs.js",
      "umd": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/GrapesJS/grapesjs.git",
    "directory": "packages/webmcp"
  },
  "keywords": [
    "grapesjs",
    "plugin",
    "webmcp",
    "mcp",
    "ai",
    "agent"
  ],
  "scripts": {
    "start": "vite",
    "build": "run-s build:lib build:umd build:dts",
    "build:lib": "vite build",
    "build:umd": "vite build --mode umd",
    "build:dts": "tsc -p tsconfig.build.json",
    "ts:check": "tsc --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "grapesjs": "^0.23.1"
  },
  "devDependencies": {
    "grapesjs": "workspace:^",
    "jest-environment-jsdom": "30.4.1",
    "npm-run-all": "4.1.5",
    "vite": "8.3.4"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
